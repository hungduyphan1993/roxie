# Whitelabel Brand Configuration (Injected at build time via BuildConfig)
BRAND_NAME=PrismCast
BRAND_TAGLINE=Live Sports & Broadcast Television
BRAND_MONOGRAM=PC
# Supported palettes: signal_mint, broadcast_crimson, cyber_cyan, electric_amber, ultraviolet
BRAND_PALETTE=signal_mint
BRAND_DARK_THEME=true
SHOW_PLAYER_WATERMARK=false
AUTO_FAILOVER=true

# Built-in Background Stream Resolver & Mirror Configuration
STREAM_MIRRORS=https://roxiestreams.info,https://roxiestreams.su
STATUS_BASE_URL=https://roxiestreams.cc
RESOLVER_SUBDOMAINS=admin2,admin,tedesco,temp
FALLBACK_DOMAIN=shadow-ran.online
INCLUDE_FALLBACK=true
PROBE_TIMEOUT_SEC=7
RESOLVER_CONCURRENCY=14
